NEXT_PUBLIC_DEV_MNEMONIC=""
NEXT_PUBLIC_DEV_ENCRYPTION_KEY=""

# XRPL account (r-address) to read public balances from in dev. Set this
# alongside the two above to skip the Xaman sign-in in a desktop browser: the
# mnemonic covers the shielded wallet, this covers the XRPL side. Without it a
# browser needs a real Xaman session, because `xumm.user.account` never settles
# when signed out and the public balance hangs on "loading" forever.
# Read-only: shielding or unshielding still needs Xaman to sign.
NEXT_PUBLIC_DEV_XRPL_ACCOUNT=""

# XUMM/Xaman app API key. Required for `next dev` (which does NOT load
# .env.production). CI/deploy builds read it from the committed .env.production.
NEXT_PUBLIC_XUMM_API_KEY=""
